includes:
  - phpstan-baseline.neon

parameters:
  typo3:
    requestGetAttributeMapping:
      route: TYPO3\CMS\Backend\Routing\Route|Symfony\Component\Routing\Route
  phpVersion: 80200
  level: 8
  paths:
    - ../Classes
  excludePaths:
    analyse:
      - ../.Build/*
  reportUnmatchedIgnoredErrors: true
  treatPhpDocTypesAsCertain: false
  type_coverage:
    return: 100
    param: 100
    property: 95
  cognitive_complexity:
    class: 35
    function: 20
